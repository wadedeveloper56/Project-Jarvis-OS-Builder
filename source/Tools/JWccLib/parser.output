Terminals unused in grammar

    "inline"
    "restrict"


Grammar

    0 $accept: translation_unit "end of file"

    1 primary_expression: "identifier"
    2                   | constant
    3                   | "(" expression ")"

    4 constant: "f_const"
    5         | "i_const"
    6         | "sting_literal"

    7 postfix_expression: primary_expression
    8                   | postfix_expression "[" expression "]"
    9                   | postfix_expression "(" ")"
   10                   | postfix_expression "(" argument_expression_list ")"
   11                   | postfix_expression "." "identifier"
   12                   | postfix_expression "->" "identifier"
   13                   | postfix_expression "++"
   14                   | postfix_expression "--"
   15                   | "(" type_name ")" "{" initializer_list "}"
   16                   | "(" type_name ")" "{" initializer_list "," "}"

   17 argument_expression_list: assignment_expression
   18                         | argument_expression_list "," assignment_expression

   19 unary_expression: postfix_expression
   20                 | "++" unary_expression
   21                 | "--" unary_expression
   22                 | unary_operator cast_expression
   23                 | "sizeof" unary_expression
   24                 | "sizeof" "(" type_name ")"

   25 unary_operator: "&"
   26               | "~"
   27               | "!"

   28 cast_expression: unary_expression
   29                | "(" type_name ")" cast_expression

   30 multiplicative_expression: cast_expression
   31                          | multiplicative_expression "*" cast_expression
   32                          | multiplicative_expression "/" cast_expression
   33                          | multiplicative_expression "%" cast_expression

   34 additive_expression: multiplicative_expression
   35                    | additive_expression "+" multiplicative_expression
   36                    | additive_expression "-" multiplicative_expression

   37 shift_expression: additive_expression
   38                 | shift_expression "<<" additive_expression
   39                 | shift_expression ">>" additive_expression

   40 relational_expression: shift_expression
   41                      | relational_expression "<" shift_expression
   42                      | relational_expression ">" shift_expression
   43                      | relational_expression "<=" shift_expression
   44                      | relational_expression ">=" shift_expression

   45 equality_expression: relational_expression
   46                    | equality_expression "==" relational_expression
   47                    | equality_expression "!=" relational_expression

   48 and_expression: equality_expression
   49               | and_expression "&" equality_expression

   50 exclusive_or_expression: and_expression
   51                        | exclusive_or_expression "^" and_expression

   52 inclusive_or_expression: exclusive_or_expression
   53                        | inclusive_or_expression "|" exclusive_or_expression

   54 logical_and_expression: inclusive_or_expression
   55                       | logical_and_expression "&&" inclusive_or_expression

   56 logical_or_expression: logical_and_expression
   57                      | logical_or_expression "||" logical_and_expression

   58 conditional_expression: logical_or_expression
   59                       | logical_or_expression "question" expression ":" conditional_expression

   60 assignment_expression: conditional_expression
   61                      | unary_expression assignment_operator assignment_expression

   62 assignment_operator: "="
   63                    | "*="
   64                    | "/="
   65                    | "%="
   66                    | "+="
   67                    | "-="
   68                    | "<<="
   69                    | ">>="
   70                    | "&="
   71                    | "^="
   72                    | "|="

   73 expression: assignment_expression
   74           | expression "," assignment_expression

   75 constant_expression: conditional_expression

   76 declaration: declaration_specifiers ";"
   77            | declaration_specifiers init_declarator_list ";"

   78 declaration_specifiers: storage_class_specifier
   79                       | storage_class_specifier declaration_specifiers
   80                       | type_specifier
   81                       | type_specifier declaration_specifiers
   82                       | type_qualifier
   83                       | type_qualifier declaration_specifiers

   84 init_declarator_list: init_declarator
   85                     | init_declarator_list "," init_declarator

   86 init_declarator: declarator
   87                | declarator "=" initializer

   88 storage_class_specifier: "typedef"
   89                        | "extern"
   90                        | "static"
   91                        | "auto"
   92                        | "register"

   93 type_specifier: "void"
   94               | "char"
   95               | "short"
   96               | INT
   97               | "long"
   98               | "long long"
   99               | "float"
  100               | "double"
  101               | "long double"
  102               | "bool"
  103               | "imaginary"
  104               | "complex"
  105               | "signed"
  106               | "unsigned"
  107               | struct_or_union_specifier
  108               | enum_specifier
  109               | "type name"

  110 struct_or_union_specifier: struct_or_union "identifier" "{" struct_declaration_list "}"
  111                          | struct_or_union "{" struct_declaration_list "}"
  112                          | struct_or_union "identifier"

  113 struct_or_union: "struct"
  114                | "union"

  115 struct_declaration_list: struct_declaration
  116                        | struct_declaration_list struct_declaration

  117 struct_declaration: specifier_qualifier_list struct_declarator_list ";"

  118 specifier_qualifier_list: type_specifier specifier_qualifier_list
  119                         | type_specifier
  120                         | type_qualifier specifier_qualifier_list
  121                         | type_qualifier

  122 struct_declarator_list: struct_declarator
  123                       | struct_declarator_list "," struct_declarator

  124 struct_declarator: declarator
  125                  | ":" constant_expression
  126                  | declarator ":" constant_expression

  127 enum_specifier: "enum" "{" enumerator_list "}"
  128               | "enum" "identifier" "{" enumerator_list "}"
  129               | "enum" "identifier"

  130 enumerator_list: enumerator
  131                | enumerator_list "," enumerator

  132 enumerator: "identifier"
  133           | "identifier" "=" constant_expression

  134 type_qualifier: "const"
  135               | "volatile"

  136 declarator: pointer direct_declarator
  137           | direct_declarator

  138 direct_declarator: "identifier"
  139                  | "(" declarator ")"
  140                  | direct_declarator "[" constant_expression "]"
  141                  | direct_declarator "[" "]"
  142                  | direct_declarator "(" parameter_type_list ")"
  143                  | direct_declarator "(" identifier_list ")"
  144                  | direct_declarator "(" ")"

  145 pointer: "*"
  146        | "*" type_qualifier_list
  147        | "*" pointer
  148        | "*" type_qualifier_list pointer

  149 type_qualifier_list: type_qualifier
  150                    | type_qualifier_list type_qualifier

  151 parameter_type_list: parameter_list
  152                    | parameter_list "," "ellipsis"

  153 parameter_list: parameter_declaration
  154               | parameter_list "," parameter_declaration

  155 parameter_declaration: declaration_specifiers declarator
  156                      | declaration_specifiers abstract_declarator
  157                      | declaration_specifiers

  158 identifier_list: "identifier"
  159                | identifier_list "," "identifier"

  160 type_name: specifier_qualifier_list
  161          | specifier_qualifier_list abstract_declarator

  162 abstract_declarator: pointer
  163                    | direct_abstract_declarator
  164                    | pointer direct_abstract_declarator

  165 direct_abstract_declarator: "(" abstract_declarator ")"
  166                           | "[" "]"
  167                           | "[" constant_expression "]"
  168                           | direct_abstract_declarator "[" "]"
  169                           | direct_abstract_declarator "[" constant_expression "]"
  170                           | "(" ")"
  171                           | "(" parameter_type_list ")"
  172                           | direct_abstract_declarator "(" ")"
  173                           | direct_abstract_declarator "(" parameter_type_list ")"

  174 initializer: assignment_expression
  175            | "{" initializer_list "}"
  176            | "{" initializer_list "," "}"

  177 initializer_list: initializer
  178                 | initializer_list "," initializer

  179 statement: labeled_statement
  180          | compound_statement
  181          | expression_statement
  182          | selection_statement
  183          | iteration_statement
  184          | jump_statement

  185 labeled_statement: "identifier" ":" statement
  186                  | "case" constant_expression ":" statement
  187                  | "default" ":" statement

  188 compound_statement: "{" "}"
  189                   | "{" statement_list "}"
  190                   | "{" declaration_list "}"
  191                   | "{" declaration_list statement_list "}"

  192 declaration_list: declaration
  193                 | declaration_list declaration

  194 statement_list: statement
  195               | statement_list statement

  196 expression_statement: ";"
  197                     | expression ";"

  198 selection_statement: "if" "(" expression ")" statement
  199                    | "if" "(" expression ")" statement "else" statement
  200                    | "switch" "(" expression ")" statement

  201 iteration_statement: "while" "(" expression ")" statement
  202                    | "do" statement "while" "(" expression ")" ";"
  203                    | "for" "(" expression_statement expression_statement ")" statement
  204                    | "for" "(" expression_statement expression_statement expression ")" statement

  205 jump_statement: "goto" "identifier" ";"
  206               | "continue" ";"
  207               | "break" ";"
  208               | "return" ";"
  209               | "return" expression ";"

  210 translation_unit: external_declaration
  211                 | translation_unit external_declaration

  212 external_declaration: function_definition
  213                     | declaration

  214 function_definition: declaration_specifiers declarator declaration_list compound_statement
  215                    | declaration_specifiers declarator compound_statement
  216                    | declarator declaration_list compound_statement
  217                    | declarator compound_statement


