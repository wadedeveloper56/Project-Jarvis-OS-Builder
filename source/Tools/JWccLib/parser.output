Terminals unused in grammar

    "inline"
    "restrict"


Grammar

    0 $accept: translation_unit "end of file"

    1 primary_expression: "identifier"
    2                   | constant
    3                   | "(" expression ")"

    4 constant: "f_const"
    5         | "i_const"
    6         | "sting_literal"

    7 postfix_expression: primary_expression
    8                   | postfix_expression "[" expression "]"
    9                   | postfix_expression "(" ")"
   10                   | postfix_expression "(" argument_expression_list ")"
   11                   | postfix_expression "." "identifier"
   12                   | postfix_expression "->" "identifier"
   13                   | postfix_expression "++"
   14                   | postfix_expression "--"
   15                   | "(" type_name ")" "{" initializer_list "}"
   16                   | "(" type_name ")" "{" initializer_list "," "}"

   17 argument_expression_list: assignment_expression
   18                         | argument_expression_list "," assignment_expression

   19 unary_expression: postfix_expression
   20                 | "++" unary_expression
   21                 | "--" unary_expression
   22                 | unary_operator cast_expression
   23                 | "sizeof" unary_expression
   24                 | "sizeof" "(" type_name ")"

   25 unary_operator: "&"
   26               | "*"
   27               | "+"
   28               | "-"
   29               | "~"
   30               | "!"

   31 cast_expression: unary_expression
   32                | "(" type_name ")" cast_expression

   33 multiplicative_expression: cast_expression
   34                          | multiplicative_expression "*" cast_expression
   35                          | multiplicative_expression "/" cast_expression
   36                          | multiplicative_expression "%" cast_expression

   37 additive_expression: multiplicative_expression
   38                    | additive_expression "+" multiplicative_expression
   39                    | additive_expression "-" multiplicative_expression

   40 shift_expression: additive_expression
   41                 | shift_expression "<<" additive_expression
   42                 | shift_expression ">>" additive_expression

   43 relational_expression: shift_expression
   44                      | relational_expression "<" shift_expression
   45                      | relational_expression ">" shift_expression
   46                      | relational_expression "<=" shift_expression
   47                      | relational_expression ">=" shift_expression

   48 equality_expression: relational_expression
   49                    | equality_expression "==" relational_expression
   50                    | equality_expression "!=" relational_expression

   51 and_expression: equality_expression
   52               | and_expression "&" equality_expression

   53 exclusive_or_expression: and_expression
   54                        | exclusive_or_expression "^" and_expression

   55 inclusive_or_expression: exclusive_or_expression
   56                        | inclusive_or_expression "|" exclusive_or_expression

   57 logical_and_expression: inclusive_or_expression
   58                       | logical_and_expression "&&" inclusive_or_expression

   59 logical_or_expression: logical_and_expression
   60                      | logical_or_expression "||" logical_and_expression

   61 conditional_expression: logical_or_expression
   62                       | logical_or_expression "question" expression ":" conditional_expression

   63 assignment_expression: conditional_expression
   64                      | unary_expression assignment_operator assignment_expression

   65 assignment_operator: "="
   66                    | "*="
   67                    | "/="
   68                    | "%="
   69                    | "+="
   70                    | "-="
   71                    | "<<="
   72                    | ">>="
   73                    | "&="
   74                    | "^="
   75                    | "|="

   76 expression: assignment_expression
   77           | expression "," assignment_expression

   78 constant_expression: conditional_expression

   79 declaration: declaration_specifiers ";"
   80            | declaration_specifiers init_declarator_list ";"

   81 declaration_specifiers: storage_class_specifier
   82                       | storage_class_specifier declaration_specifiers
   83                       | type_specifier
   84                       | type_specifier declaration_specifiers
   85                       | type_qualifier
   86                       | type_qualifier declaration_specifiers

   87 init_declarator_list: init_declarator
   88                     | init_declarator_list "," init_declarator

   89 init_declarator: declarator
   90                | declarator "=" initializer

   91 storage_class_specifier: "typedef"
   92                        | "extern"
   93                        | "static"
   94                        | "auto"
   95                        | "register"

   96 type_specifier: "void"
   97               | "char"
   98               | "short"
   99               | INT
  100               | "long"
  101               | "long long"
  102               | "float"
  103               | "double"
  104               | "long double"
  105               | "bool"
  106               | "signed"
  107               | "unsigned"
  108               | struct_or_union_specifier
  109               | enum_specifier
  110               | "type name"

  111 struct_or_union_specifier: struct_or_union "identifier" "{" struct_declaration_list "}"
  112                          | struct_or_union "{" struct_declaration_list "}"
  113                          | struct_or_union "identifier"

  114 struct_or_union: "struct"
  115                | "union"

  116 struct_declaration_list: struct_declaration
  117                        | struct_declaration_list struct_declaration

  118 struct_declaration: specifier_qualifier_list struct_declarator_list ";"

  119 specifier_qualifier_list: type_specifier specifier_qualifier_list
  120                         | type_specifier
  121                         | type_qualifier specifier_qualifier_list
  122                         | type_qualifier

  123 struct_declarator_list: struct_declarator
  124                       | struct_declarator_list "," struct_declarator

  125 struct_declarator: declarator
  126                  | ":" constant_expression
  127                  | declarator ":" constant_expression

  128 enum_specifier: "enum" "{" enumerator_list "}"
  129               | "enum" "identifier" "{" enumerator_list "}"
  130               | "enum" "identifier"

  131 enumerator_list: enumerator
  132                | enumerator_list "," enumerator

  133 enumerator: "identifier"
  134           | "identifier" "=" constant_expression

  135 type_qualifier: "const"
  136               | "volatile"

  137 declarator: pointer direct_declarator
  138           | direct_declarator

  139 direct_declarator: "identifier"
  140                  | "(" declarator ")"
  141                  | direct_declarator "[" constant_expression "]"
  142                  | direct_declarator "[" "]"
  143                  | direct_declarator "(" parameter_type_list ")"
  144                  | direct_declarator "(" identifier_list ")"
  145                  | direct_declarator "(" ")"

  146 pointer: "*"
  147        | "*" type_qualifier_list
  148        | "*" pointer
  149        | "*" type_qualifier_list pointer

  150 type_qualifier_list: type_qualifier
  151                    | type_qualifier_list type_qualifier

  152 parameter_type_list: parameter_list
  153                    | parameter_list "," "ellipsis"

  154 parameter_list: parameter_declaration
  155               | parameter_list "," parameter_declaration

  156 parameter_declaration: declaration_specifiers declarator
  157                      | declaration_specifiers abstract_declarator
  158                      | declaration_specifiers

  159 identifier_list: "identifier"
  160                | identifier_list "," "identifier"

  161 type_name: specifier_qualifier_list
  162          | specifier_qualifier_list abstract_declarator

  163 abstract_declarator: pointer
  164                    | direct_abstract_declarator
  165                    | pointer direct_abstract_declarator

  166 direct_abstract_declarator: "(" abstract_declarator ")"
  167                           | "[" "]"
  168                           | "(" ")"
  169                           | "[" constant_expression "]"
  170                           | "(" parameter_type_list ")"
  171                           | direct_abstract_declarator "[" "]"
  172                           | direct_abstract_declarator "(" ")"
  173                           | direct_abstract_declarator "[" constant_expression "]"
  174                           | direct_abstract_declarator "(" parameter_type_list ")"

  175 initializer: assignment_expression
  176            | "{" initializer_list "}"
  177            | "{" initializer_list "," "}"

  178 initializer_list: initializer
  179                 | initializer_list "," initializer

  180 statement: labeled_statement
  181          | compound_statement
  182          | expression_statement
  183          | selection_statement
  184          | iteration_statement
  185          | jump_statement

  186 labeled_statement: "identifier" ":" statement
  187                  | "case" constant_expression ":" statement
  188                  | "default" ":" statement

  189 compound_statement: "{" "}"
  190                   | "{" statement_list "}"
  191                   | "{" declaration_list "}"
  192                   | "{" declaration_list statement_list "}"

  193 declaration_list: declaration
  194                 | declaration_list declaration

  195 statement_list: statement
  196               | statement_list statement

  197 expression_statement: ";"
  198                     | expression ";"

  199 selection_statement: "if" "(" expression ")" statement
  200                    | "if" "(" expression ")" statement "else" statement
  201                    | "switch" "(" expression ")" statement

  202 iteration_statement: "while" "(" expression ")" statement
  203                    | "do" statement "while" "(" expression ")" ";"
  204                    | "for" "(" expression_statement expression_statement ")" statement
  205                    | "for" "(" expression_statement expression_statement expression ")" statement

  206 jump_statement: "goto" "identifier" ";"
  207               | "continue" ";"
  208               | "break" ";"
  209               | "return" ";"
  210               | "return" expression ";"

  211 translation_unit: external_declaration
  212                 | translation_unit external_declaration

  213 external_declaration: function_definition
  214                     | declaration

  215 function_definition: declaration_specifiers declarator declaration_list compound_statement
  216                    | declaration_specifiers declarator compound_statement
  217                    | declarator declaration_list compound_statement
  218                    | declarator compound_statement


